{
  "manifest_version": 3,
  "name": "Deadline Reminder",
  "version": "1.0.0",
  "description": "Auto-detects course and assignment deadlines across educational platforms (Canvas, Moodle, Google Classroom, Blackboard, Brightspace) and exports them to Google Calendar or .ics files.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "*://*.instructure.com/*",
    "*://*.moodle.org/*",
    "*://*.moodlecloud.com/*",
    "*://classroom.google.com/*",
    "*://*.blackboard.com/*",
    "*://*.brightspace.com/*",
    "*://*.d2l.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instructure.com/*",
        "*://*.moodle.org/*",
        "*://*.moodlecloud.com/*",
        "*://classroom.google.com/*",
        "*://*.blackboard.com/*",
        "*://*.brightspace.com/*",
        "*://*.d2l.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
